{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Пакет потребляется из исходников (Metro на клиенте, vitest в тестах),
    // собранный dist/ никому не нужен — tsc здесь только проверяет типы.
    "noEmit": true
  },
  "include": ["src", "test"]
}
