# Копируется в .env рядом с docker-compose.yml на самом VPS.
# Ничего отсюда не хардкодить в коде — только через переменные окружения.

# Домен, на который смотрит DNS A-запись VPS. Пока нет своего домена,
# можно использовать бесплатный поддомен, например DuckDNS: xxx.duckdns.org
DOMAIN=chat.example.com

# Почта для Let's Encrypt (уведомления об истечении/проблемах с сертификатом)
ACME_EMAIL=admin@example.com

# Настройки сервера (см. server/.env.example для локального запуска без Docker)
MESSAGE_TTL_DAYS=14
DEFAULT_INVITE_TTL_HOURS=24
LOG_LEVEL=info
