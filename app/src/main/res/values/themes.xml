<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Application theme for Pathogen.
        Uses the AppCompat NoActionBar variant so no Material dependency is needed.
    -->
    <style name="Theme.Pathogen" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/surfaceColor</item>
    </style>
</resources>
