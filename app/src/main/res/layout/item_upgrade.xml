<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#0D1F2D"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvUpgradeIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🦠"
            android:textSize="24sp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvUpgradeName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#667788"
                    android:textSize="11sp"
                    android:background="#1A2A3A"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvUpgradeDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8899AA"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvUpgradeCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#44AAFF"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <Button
                android:id="@+id/btnBuy"
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:text="Купить"
                android:textSize="11sp"
                android:backgroundTint="#440022"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
