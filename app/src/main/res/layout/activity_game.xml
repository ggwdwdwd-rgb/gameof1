<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040C18">

    <!-- Верхний HUD + уведомления -->
    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0A1628"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🦠 ЗАРАЖЕНИЕ"
                        android:textColor="#FF5533"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvInfected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% · 0"
                        android:textColor="#FF2200"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="День 0"
                    android:textColor="#445566"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginHorizontal="10dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💊 ЛЕКАРСТВО"
                        android:textColor="#22BB77"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvCure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#00CC66"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/progressInfection"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:progressTint="#FF2200"
                    android:progressBackgroundTint="#1A0000"/>

                <View android:layout_width="8dp" android:layout_height="1dp"/>

                <ProgressBar
                    android:id="@+id/progressCure"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:progressTint="#00CC66"
                    android:progressBackgroundTint="#001A0A"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Событие (скрыто по умолчанию) -->
        <TextView
            android:id="@+id/tvEventNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14060200"
            android:text=""
            android:textColor="#FFAA33"
            android:textSize="12sp"
            android:padding="7dp"
            android:gravity="center"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Карта мира (с зумом и паном) -->
    <com.gameof1.game.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topContainer"
        app:layout_constraintBottom_toTopOf="@id/tvNews"/>

    <!-- Лента новостей -->
    <TextView
        android:id="@+id/tvNews"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:background="#060E1C"
        android:textColor="#FFAA33"
        android:textSize="11sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:focusable="true"
        android:text="📡 Мир в порядке..."
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"/>

    <!-- Оверлей инфо страны (низ-лево, поверх карты) -->
    <LinearLayout
        android:id="@+id/countryInfoPanel"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#D00A1830"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvNews"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp">

        <TextView
            android:id="@+id/tvCountryFlag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌍"
            android:textSize="28sp"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCountryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Страна"
                android:textColor="#DDDDFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvCountryStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#667799"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvCountryInfPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FF5533"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="заражено"
                android:textColor="#445566"
                android:textSize="9sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Нижняя панель управления -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0A1628"
        android:padding="10dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvDNA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧬 0 ДНК"
            android:textColor="#44AAFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnSpeedPause"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:text="⏸"
            android:textSize="13sp"
            android:backgroundTint="#1A2840"
            android:paddingHorizontal="0dp"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btnSpeed1x"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:text="1×"
            android:textSize="12sp"
            android:backgroundTint="#22344E"
            android:paddingHorizontal="0dp"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btnSpeed2x"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:text="2×"
            android:textSize="12sp"
            android:backgroundTint="#1A2840"
            android:paddingHorizontal="0dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="↺"
            android:textSize="16sp"
            android:backgroundTint="#1A2A3A"
            android:visibility="gone"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnUpgrade"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="🧬 Мутации"
            android:textSize="12sp"
            android:backgroundTint="#550022"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
