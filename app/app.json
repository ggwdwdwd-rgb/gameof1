{
  "expo": {
    "name": "Cry",
    "slug": "family-messenger",
    "owner": "zykoi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "familymsg",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "re.familymessenger.app",
      "adaptiveIcon": {
        "backgroundColor": "#c25f38",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-libsodium",
        {}
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы отсканировать QR-код инвайта."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к галерее нужен, чтобы отправить фото в чат."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен, чтобы записать и отправить голосовое сообщение."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна, чтобы один раз отправить её в чат кнопкой «я тут»."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d97757",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Доступ к фото нужен, чтобы сохранять полученные изображения в галерею.",
          "savePhotosPermission": "Разрешение нужно, чтобы сохранить фото из чата в галерею.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
