{
  "expo": {
    "name": "Cry",
    "slug": "family-messenger",
    "owner": "zykoi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "familymsg",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "re.familymessenger.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["react-native-libsodium", {}],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы отсканировать QR-код инвайта."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к галерее нужен, чтобы отправить фото в чат.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен, чтобы записать и отправить голосовое сообщение."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна, чтобы один раз отправить её в чат кнопкой «я тут»."
        }
      ]
    ]
  }
}
