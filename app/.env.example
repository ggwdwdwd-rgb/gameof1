# Скопировать в .env рядом с app.json. Значение подставляется в поле "Адрес
# сервера" на экране онбординга по умолчанию — там же его можно поменять
# вручную (например, на ws://192.168.1.50:8080/ws для локальной отладки без
# Caddy/TLS в той же Wi-Fi сети, пока сервер ещё не задеплоен на VPS).
EXPO_PUBLIC_SERVER_WS_URL=wss://chat.example.com/ws
